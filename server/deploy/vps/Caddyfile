188-166-154-201.sslip.io {
	# Static phone-controller assets are deployed with the server.
	handle /static/* {
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		root * /opt/phone_arm
		file_server
	}

	# Root-scoped, network-only service worker for the installable web app.
	handle /sw.js {
		header Service-Worker-Allowed "/"
		header Cache-Control "no-cache, no-store, must-revalidate"
		rewrite * /static/sw.js
		root * /opt/phone_arm
		file_server
	}

	# Root path -> operator index page. Matched via named matcher so it's
	# EXACT, not the prefix "/" (which would swallow everything).
	@controller_page path / /robot/*
	handle @controller_page {
		header Cache-Control "no-cache, no-store, must-revalidate"
		rewrite * /static/index.html
		root * /opt/phone_arm
		file_server
	}

	# Each robot publishes to its own MediaMTX path. The session API validates
	# the short-lived publish/view capability before the request reaches
	# MediaMTX; the raw invitation token is never used here.
	@session_media path_regexp sessionMedia ^/media/(r_[A-Za-z0-9_-]{12,40})/(whip|whep).*$
	handle @session_media {
		forward_auth http://127.0.0.1:8080 {
			uri /api/media/authorize
			header_up X-Media-Session {re.sessionMedia.1}
			header_up X-Media-Action {re.sessionMedia.2}
		}
		uri strip_prefix /media
		reverse_proxy http://127.0.0.1:8889 {
			header_up -Authorization
		}
	}

	# The follower registers its current relay and video configuration outbound.
	# Browser requests terminate here; no inbound tunnel to the follower exists.
	@session_api path /api/follower/* /api/robots /webrtc/config /leader/config /control/release /stats /test_event /healthz
	handle @session_api {
		reverse_proxy http://127.0.0.1:8080
	}

	handle {
		respond 404
	}
}
