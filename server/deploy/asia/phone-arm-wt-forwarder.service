[Unit]
Description=Phone Arm symmetric WebTransport edge (Asia to London)
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/wt-venv/bin/python /opt/phone_arm/webtransport_forwarder.py --host 0.0.0.0 --port 4434 --certificate /var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/146-190-104-81.sslip.io/146-190-104-81.sslip.io.crt --private-key /var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/146-190-104-81.sslip.io/146-190-104-81.sslip.io.key --upstream https://188-166-154-201.sslip.io:4433 --event-log /var/log/phone-arm-wt-forwarder-events.jsonl --max-datagram-bytes 1024
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SupplementaryGroups=caddy

[Install]
WantedBy=multi-user.target
